{
  "manifest_version": 3,
  "name": "צ'אט צד",
  "version": "1.0.0",
  "description": "צ'אט קטן בצד שמאל של הדפדפן",
  "icons": { "48": "icon.svg", "96": "icon.svg", "128": "icon.svg" },
  "host_permissions": ["https://*.supabase.co/*"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    { "resources": ["chat.html"], "matches": ["<all_urls>"] }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "side-chat@netanelrabi.example",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "personalCommunications"]
      }
    }
  }
}
